# ============================================================
# TerraMerge — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env-example .env
#
# NEVER commit .env to the repository.
#
# These variables are read by conf/config.yaml and conf/data/fast.yaml via Hydra's
# ${oc.env:VAR_NAME} resolver, and loaded from this file by python-dotenv at the top of
# src/main.py (load_dotenv()). TERRAMERGE_BASE_DIR has no fallback default — a missing value
# fails loudly at startup, since there is no safe default base directory.
# ============================================================

# --- General ---
ENV=development                     # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- EGIB dataset paths (extracted from conf/config.yaml — was hardcoded, machine-specific) ---
# Root directory containing yearly EGIB File Geodatabase exports (rok_YYYY/*.gdb)
TERRAMERGE_BASE_DIR=/path/to/EGIB_new/pow_ostrodzki

# Path to the DuckDB database file used for all cadastral/feature tables
TERRAMERGE_DUCKDB_PATH=/path/to/artifacts/duckdb/terramerge.duckdb

# Path to the transaction-prices Parquet file joined onto parcels
TERRAMERGE_TRANSACTIONS_PATH=/path/to/artifacts/parquet/transakcje.parquet

# Path to the MPZP (zoning plan) mapping CSV
TERRAMERGE_MPZP_MAPPING_CSV=/path/to/artifacts/csv/mpzp.csv

# --- "fast" data profile (extracted from conf/data/fast.yaml) ---
# Smaller/testing EGIB base directory used for quick local runs
TERRAMERGE_FAST_BASE_DIR=/path/to/EGIB_new/powiat_testowy
